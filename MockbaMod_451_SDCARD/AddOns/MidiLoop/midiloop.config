##********************* NAMED MACROS ****************************
# you can create Macros by giving them a unique name starting with MACRO_XXXX where XXXX is name of your Macro and then you can assign theese nameed macros to any triggers.
# this has benn done to avoid polluting assignments earlier as well as reusibility.

##NOTE MACROS and their touch points need to be redone as gui and control placements have changed in FW 3.5+

#--------------SAMPLE EDITOR MACROS ------------


#based on default layout  where sample editor icon/button is page:1 row 2 col:4 #these have been tested and tweaked to wirk with 3.5
 

MACRO_SAMPLE_NORMALIZE = MENU-SAMPLE-EDIT WAITX10 TOUCH~NONE~PROCESS~1200x700 WAITx1 TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~NORMALIZE~60x300 WAITx10  TOUCH~NONE~DOIT~1000x700 #Normalize Sample


MACRO_SAMPLE_GAIN-3 = MENU-SAMPLE-EDIT WAITX10 TOUCH~NONE~PROCESS~1200x700 WAITx1  TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~GAINCHANGE~800x400 WAITx5 TOUCH~NONE~GAINKNOB~640x400   WAITx10 VALUE--x50 WAITx1 VALUE++x15 WAITx5 TOUCH~NONE~DOIT~1000x700 #reduce sample gain by -3 dB


MACRO_SAMPLE_GAIN+3 = MENU-SAMPLE-EDIT WAITX10  TOUCH~NONE~PROCESS~1200x700 WAITx1  TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~GAINCHANGE~800x400 WAITx5 TOUCH~NONE~GAINKNOB~640x400   WAITx10 VALUE--x50 WAITx1 VALUE++x21 WAITx5 TOUCH~NONE~DOIT~1000x700 #increase sample gain by +3 dB

MACRO_SAMPLE_DISCARD =  MENU-SAMPLE-EDIT WAITX10   TOUCH~NONE~PROCESS~1200x700 WAITx1  TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~DISCARD~60x220 WAITx1 TOUCH~NONE~DOIT~1000x700 #discard (trim to selected)

MACRO_SAMPLE_DELETESEL =  MENU-SAMPLE-EDIT WAITX10  TOUCH~NONE~PROCESS~1200x700 WAITx1  TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~DISCARD~480x220 WAITx1 TOUCH~NONE~DOIT~1000x700 #delete selected

MACRO_SAMPLE_EXTRACT =  MENU-SAMPLE-EDIT WAITX10   TOUCH~NONE~PROCESS~1200x700 WAITx1  TOUCH~NONE~FUNCTIONS~250x700 WAITx5 TOUCH~NONE~DISCARD~1120x220 WAITx1 TOUCH~NONE~DOIT~1000x700 #extract to new sample


#-------------- MIDI CLIP MACROS

MACRO_MIDI_COPY_SELECTED = TOUCH~SHOW-CLIP~grid~120x50 WAITx5  TOUCH~SHIFT~copy~600x700 #copy events
MACRO_MIDI_PASTE          = TOUCH~SHOW-CLIP~grid~120x50 WAITx5 TOUCH~SHIFT~paste~660x700 #paste events
MACRO_MIDI_SELECT_ALL = TOUCH~SHOW-CLIP~grid~120x50 WAITx1 TOUCH~AT~MARQUEE~620x50 TOUCH~AT~CLIP~320x250 WAITx1 TOUCH~SHIFT~SELECT-ALL~30x700

MACRO_MIDI_OCT- = TOUCH~SHOW-CLIP~grid~120x50 WAITx1 TOUCH~AT~MARQUEE~620x50 TOUCH~AT~CLIP~320x250 WAITx1 TOUCH~SHIFT~SELECT-ALL~30x700 WAITx1 TOUCH~AT~TRANSPOSE~1020x700 WAITx5 VALUE--x12 

