 ##econfig
#config Name: default
/***************************************************(*****************)
This is Config File For Mockba Mod MidiLoop V4.5x+
-- PLEASE EXCUSE ANY TYPOS -- I'm a Developer not a Content Writer ;=)

THIS config file is for FORCE 3.5 and Above. A lot of things have changed and some Macros/functions might not work.
please report any non working shortcuts / functions in discord group so i can inspect them or fix them.
Since Force now natively supports tempo Automation and follow actions on rows, those function might be redundant. but have been kept and removing those is lot more work 
than just ignoring them ;).s

Please read the accompanying midiloop-functions-reference.txt files for all
the available functions, triggers and Macros and what not.
#ad of version 4.04 All macros/command containing a * become repeatable, so the button assigned to REPEAT-LAST Will trigger last Repeatable Command..

***************************************************************************/
#configuration parameters change values as per needs.

CONTROL-MIDI-CHANNEL = 1
TRIGGER-THRESHOLD = 127
USE-ABSOLUTE-TRIGGER = 1


MACRO_DELAY = 10
TOUCH-DELAY = 5 #was 250
POPUP-WAIT-TIME = 50 
PAGING-DELAY = 1


USE-ALT-REL-TEMPO-METHOD = 0 
USE-ALT-ABS-TEMPO-METHOD = 1


ENABLE-DIRECT-DELETE = 0  #if one pressing delete button dseltes selected content in clip. otherwise double delete button press


TEMPO-WINDOW-TIMEOUT=1200
SPECIAL-FUNCTIONS-ON = 1

NUM-PAGES = 4  #for 32x32 matrix => (8*4 x 8*4)


LOG-OUTPUT = 0


DOUBLE-PRESS-TIMEOUT = 300
DOUBLE-PRESS-TRACK-SELECT = 1


SCENE-8TO1=0
USE-TAP-TEMPO-TRIGGERING = 1  # use 1 or 0 , 1=feature enabled
TAP-TEMPO-TRIGGER-COMMAND = LAUNCH-SCENE-1 #this command will be executed after tap tempo press number based on value below set this to value number of taps in Force + 1
TAP-TEMPO-TRIGGER-COUNT = 5  #this value of tap press will trigger the above command
MAX-TAP-DETECT-DELAY-MS = 1000 #time in ms any tap tempo presses within this time period are counted as valid otherwise reset to zero. set to larger value for BPM slower than 60.



BLINK-SELECT-WHILE-CAPTURING = 0  #enable disable select button blink while audio/video capture.
PAGE-DEBOUNCE = 250 # in ms, any page change requests within less than this will be rejected (pad macros send triggers two times so this filters out second one.) 
DEBOUNCE-TIME = 1000 # in ms, any special function  requests like HALF-SPEED, HUMANIZE-CLIP, RANDOMIZE-CLIP... within less than this will be rejected (pad macros send triggers two times so this filters out second one.) 

LOOPBACK-ON = 0 
LOOPBACK-ROUTE-16-TO-CONTROL-CH = 1 #any messages sent to ch 16 will echo back to channel 15 on loopback port.


MIDI-HW-PORT-NAME = Arturia BeatStep Pro #Launch Control XL Launch Contro

#combo multipliers for data dial and +/- buttons
SELECT-KNOB-MULTIPLIER = 50 #Multiplier to use for each jump of data dial with SELECT Held  usually only works for value of 4.
EDIT-KNOB-MULTIPLIER = 10 #Multiplier to use for each jump of data dial with Edit Held usually only works for value of 4.
SHIFT-PLUS-MINUS-MULTIPLIER=10 # Multiplier to use for each press of  + or - button with SHIFT held
SELECT-PLUS-MINUS-MULTIPLIER=50 # Multiplier to use for each press of + or - button with SELECT held
EDIT-PLUS-MINUS-MULTIPLIER=16 # Multiplier to use for each press of + or - button with SELECT held

## IMPORTANT ALWAYS USE some value after = (like -) otherwise the config wont work and midiloop will close.
